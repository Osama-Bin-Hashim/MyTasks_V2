<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:fitsSystemWindows="true">

    <!-- DYNAMIC HEADER: User Greeting -->
    <TextView
        android:id="@+id/tvDashboardTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_16sdp"
        android:layout_marginTop="@dimen/_16sdp"
        android:text="Dashboard: User"
        android:textColor="#333333"
        android:textSize="@dimen/_18ssp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/dashboardScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/bottomFormContainer"
        app:layout_constraintTop_toBottomOf="@id/tvDashboardTitle">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- HEADER: Project Progress -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/globalStatsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/_16sdp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="@dimen/_16sdp"
                app:cardElevation="@dimen/_4sdp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/_20sdp">

                    <TextView
                        android:id="@+id/tvMgrPerfTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Global Progress"
                        android:textColor="#808080"
                        android:textSize="@dimen/_12ssp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvGlobalProgress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_8sdp"
                        android:text="0%"
                        android:textColor="#333333"
                        android:textSize="@dimen/_28ssp"
                        android:textStyle="bold" />

                    <ProgressBar
                        android:id="@+id/pbGlobalProgress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_8sdp"
                        android:layout_marginTop="@dimen/_12sdp"
                        android:max="100"
                        android:progress="0"
                        android:progressDrawable="@drawable/custom_progress_bar" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- SECTION: Status Distribution -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_16sdp"
                android:text="Status Distribution"
                android:textColor="#333333"
                android:textSize="@dimen/_14ssp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/_16sdp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="@dimen/_16sdp"
                app:cardElevation="@dimen/_4sdp">

                <com.github.mikephil.charting.charts.PieChart
                    android:id="@+id/pieChartStatus"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:padding="@dimen/_12sdp" />
            </com.google.android.material.card.MaterialCardView>

            <!-- SECTION: Priority Breakdown -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_16sdp"
                android:text="Priority Breakdown"
                android:textColor="#333333"
                android:textSize="@dimen/_14ssp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/_16sdp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="@dimen/_16sdp"
                app:cardElevation="@dimen/_4sdp">

                <com.github.mikephil.charting.charts.PieChart
                    android:id="@+id/priorityChart"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:padding="@dimen/_12sdp" />
            </com.google.android.material.card.MaterialCardView>

            <!-- SECTION: Employee Workload -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_16sdp"
                android:text="Employee Workload"
                android:textColor="#333333"
                android:textSize="@dimen/_14ssp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/workloadCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/_16sdp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="@dimen/_16sdp"
                app:cardElevation="@dimen/_4sdp">

                <com.github.mikephil.charting.charts.BarChart
                    android:id="@+id/barChartWorkload"
                    android:layout_width="match_parent"
                    android:layout_height="250dp"
                    android:padding="@dimen/_12sdp" />
            </com.google.android.material.card.MaterialCardView>

            <!-- SECTION: Team Performance -->
            <TextView
                android:id="@+id/tvRosterTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_16sdp"
                android:text="Team Performance"
                android:textColor="#333333"
                android:textSize="@dimen/_14ssp"
                android:textStyle="bold" />

            <!-- ROSTER LIST -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvRosterPerformance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_8sdp"
                android:layout_marginTop="@dimen/_8sdp"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:paddingBottom="@dimen/_16sdp"
                tools:listitem="@layout/item_roster_performance" />

            <!-- Hidden legacy view for code compatibility -->
            <TextView
                android:id="@+id/tvTaskSummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- PINNED ACTION SHEET CONTAINER -->
    <LinearLayout
        android:id="@+id/bottomFormContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/enrollmentFormCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#FFFFFF"
            app:cardElevation="@dimen/_12sdp"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.TopRounded">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/_16sdp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Enroll New Member"
                    android:textColor="#333333"
                    android:textSize="@dimen/_12ssp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_12sdp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/inputNewMemberUsername"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/_40sdp"
                        android:layout_weight="1"
                        android:background="@drawable/edittext_bg"
                        android:hint="Enter colleague's username"
                        android:inputType="text"
                        android:paddingHorizontal="@dimen/_12sdp"
                        android:textColor="#333333"
                        android:textSize="@dimen/_12ssp" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnAddMemberToProject"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/_40sdp"
                        android:layout_marginStart="@dimen/_8sdp"
                        android:background="#333333"
                        android:paddingHorizontal="@dimen/_16sdp"
                        android:text="+ Add to Project"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="@dimen/_12ssp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Hidden legacy view for code compatibility -->
                <TextView
                    android:id="@+id/tvRosterList"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
