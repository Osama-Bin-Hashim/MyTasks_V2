<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/_16sdp"
    android:layout_marginHorizontal="@dimen/_12sdp"
    android:layout_marginTop="@dimen/_4sdp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="@dimen/_8sdp"
    app:cardElevation="@dimen/_4sdp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/_16sdp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/taskTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@+id/controlLayout"
                android:text="Task Title"
                android:textColor="#333333"
                android:textSize="@dimen/_16ssp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/controlLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnEditTask"
                    android:layout_width="@dimen/_24sdp"
                    android:layout_height="@dimen/_24sdp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="@dimen/_4sdp"
                    android:scaleType="fitCenter"
                    android:src="@android:drawable/ic_menu_edit"
                    app:tint="#808080" />

                <ImageButton
                    android:id="@+id/btnDeleteTask"
                    android:layout_width="@dimen/_24sdp"
                    android:layout_height="@dimen/_24sdp"
                    android:layout_marginStart="@dimen/_4sdp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="@dimen/_4sdp"
                    android:scaleType="fitCenter"
                    android:src="@android:drawable/ic_menu_delete"
                    app:tint="#FF4444" />
            </LinearLayout>
        </RelativeLayout>

        <TextView
            android:id="@+id/priorityTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8sdp"
            android:background="@android:color/holo_red_light"
            android:paddingHorizontal="@dimen/_8sdp"
            android:paddingVertical="@dimen/_2sdp"
            android:text="CRITICAL"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/_10ssp" />

        <TextView
            android:id="@+id/taskStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_4sdp"
            android:text="Status: PENDING"
            android:textColor="#666666"
            android:textSize="@dimen/_12ssp" />

        <TextView
            android:id="@+id/tvTaskDescriptionDisplay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_4sdp"
            android:text="Task Description goes here..."
            android:textColor="#808080"
            android:textSize="@dimen/_11ssp" />

        <TextView
            android:id="@+id/tvAssignedTeamDisplay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_4sdp"
            android:text="Team: Osama, Alice"
            android:textColor="#333333"
            android:textSize="@dimen/_11ssp"
            android:textStyle="italic" />

        <TextView
            android:id="@+id/tvDeadlineDisplay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_4sdp"
            android:text="Deadline: 2026-05-27 10:30 AM"
            android:textColor="#808080"
            android:textSize="@dimen/_10ssp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnStartTask"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_32sdp"
            android:layout_gravity="end"
            android:layout_marginTop="@dimen/_12sdp"
            android:background="#0099CC"
            android:paddingHorizontal="@dimen/_16sdp"
            android:text="START TASK"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/_12ssp"
            android:visibility="gone" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnMarkDone"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_32sdp"
            android:layout_gravity="end"
            android:layout_marginTop="@dimen/_12sdp"
            android:background="#333333"
            android:paddingHorizontal="@dimen/_16sdp"
            android:text="MARK DONE"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/_12ssp" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
